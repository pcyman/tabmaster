{
  "manifest_version": 3,
  "name": "TabMaster",
  "version": "0.1.1",
  "description": "Copy all current-window tab URLs and open tabs from a pasted URL list.",
  "browser_specific_settings": {
    "gecko": {
      "id": "tabmaster@local",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": ["tabs", "clipboardWrite"],
  "icons": {
    "48": "icons/48.png",
    "96": "icons/96.png"
  },
  "action": {
    "default_title": "TabMaster",
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icons/48.png",
      "96": "icons/96.png"
    }
  }
}
